    {
      "name": "9. Nakshatra reference (birth-star remedies)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/vedic-astrology/nakshatras/anuradha?lang=en",
          "host": [
