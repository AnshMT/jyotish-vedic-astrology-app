{
  "info": {
    "name": "Jyotish Kundali — RoxyAPI",
    "description": "Every RoxyAPI endpoint used by the Kundali page (src/app/kundali/actions.ts, src/lib/roxy/remedies.ts) in the jyotish-vedic-astrology-app repo. See docs/roxyapi-kundli-endpoints.md for the full write-up.\n\nSet the `roxyApiKey` collection variable to a real RoxyAPI key before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{roxyApiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://roxyapi.com/api/v2",
      "type": "string"
    },
    {
      "key": "roxyApiKey",
      "value": "YOUR_ROXYAPI_KEY",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Birth chart (D1 Rashi)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"1990-05-10\",\n  \"time\": \"19:55:00\",\n  \"latitude\": 19.2,\n  \"longitude\": 72.88,\n  \"timezone\": 5.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/vedic-astrology/birth-chart?lang=en",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vedic-astrology",
            "birth-chart"
          ],
          "query": [
            {
              "key": "lang",
              "value": "en"
            }
          ]
        },
        "description": "Powers RoxyVedicKundli and RoxyVedicPlanetsTable (Rashi (D1) tab, Planets tab)."
      },
      "response": []
    },
    {
      "name": "2. Divisional (varga) chart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"1990-05-10\",\n  \"time\": \"19:55:00\",\n  \"latitude\": 19.2,\n  \"longitude\": 72.88,\n  \"timezone\": 5.5,\n  \"division\": 9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/vedic-astrology/divisional-chart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vedic-astrology",
            "divisional-chart"
          ]
        },
        "description": "Powers the Varga tab. generateKundali calls this eagerly with division 9 (Navamsa); fetchDivisionalChart calls it again for any of 2,3,4,7,9,10,12,16,20,24,27,30,40,45,60. The app does not forward lang here even though the endpoint accepts it."
      },
      "response": []
    },
