{
  "info": {
    "name": "Jyotish Kundli — AstrologyAPI",
    "description": "Every AstrologyAPI endpoint used by the Kundli page (src/app/astrologyapi/kundli/actions.ts) in the jyotish-vedic-astrology-app repo. See docs/astrologyapi-kundli-endpoints.md for the full write-up.\n\nSet the `astrologyApiKey` collection variable to a real AstrologyAPI access token before sending requests. No endpoint here accepts a lang parameter, and none of these requests set ayanamsha (so every response uses the vendor's Lahiri default).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-astrologyapi-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{astrologyApiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://json.astrologyapi.com/v1",
      "type": "string"
    },
    {
      "key": "astrologyApiKey",
      "value": "YOUR_ASTROLOGYAPI_ACCESS_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Planets",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "day",
              "value": "10",
              "type": "text"
            },
            {
              "key": "month",
              "value": "5",
              "type": "text"
            },
            {
              "key": "year",
              "value": "1990",
              "type": "text"
            },
            {
              "key": "hour",
              "value": "19",
              "type": "text"
            },
            {
              "key": "min",
              "value": "55",
              "type": "text"
            },
            {
              "key": "lat",
              "value": "19.20",
              "type": "text"
            },
            {
              "key": "lon",
              "value": "72.88",
              "type": "text"
            },
            {
              "key": "tzone",
              "value": "5.5",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/planets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "planets"
          ]
        },
        "description": "Powers AstrologyApiPlanetsTable (Planets tab). Returns the 9 grahas plus a synthetic Ascendant row."
      },
      "response": []
    },
